{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "**/TimeCockpit.Data.dll",
            "**/TimeCockpit.Data.Export.dll",
            "**/TimeCockpit.Data.Import.dll",
            "**/TimeCockpit.Data.QueryLanguage.dll"
          ],
          "exclude": [
            "**/*.resources.dll",
            "**/TimeCockpit.Test.*.dll",
            "**/obj/**",
            "**/bin/**",
            "_site/**"
          ],
          "src": "../Binaries"
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/**.md"
        ]
      },
      {
        "files": [
          "doc/**.md",
          "doc/**/toc.yml",
          "toc.yml",
          "*.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**",
          "tools/**",
          "templates/**",
          "AGENTS.md",
          "CLAUDE.md",
          "not-available.md",
          "not-available-page.md",
          "only-in-preview-available.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/images/**",
          "fonts/**",
          "**/code/**",
          "web.config",
          "App_Code/**",
          "App_Data/**",
          "favicon.ico",
          "robots.txt",
          "robots.dev.txt",
          "llms.txt",
          "llms-full.txt",
          "context7.json",
          "google04b49cc9afcdf4d4.html"
        ],
        "exclude": [
          "obj/**",
          "_site/**",
          "tools/**",
          "templates/**"
        ]
      }
    ],
    // "overwrite": [
    //   {
    //     "files": [
    //       "apidoc/**.md"
    //     ],
    //     "exclude": [
    //       "obj/**",
    //       "_site/**"
    //     ]
    //   }
    // ],
    "dest": "_site",
    "globalMetadataFiles": [],
    "globalMetadata": {
      "_appFaviconPath": "images/favicon.ico",
      "_appFooter": "Copyright © 2026 software architects gmbh &middot; <a href=\"https://www.timecockpit.com/legal-notice/overview/\" target=\"_blank\" rel=\"noopener\">Imprint</a> &middot; <a href=\"https://www.timecockpit.com/legal-notice/privacy-policy/\" target=\"_blank\" rel=\"noopener\">Privacy Statement</a> &middot; <a href=\"javascript:window.renewCookieConsent()\">Cookie settings</a>",
      "_appLogoPath": "images/time-cockpit-logo.svg",
      "_appName": "time cockpit",
      "_appTitle": "time cockpit",
      "_lang": "en",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "fileMetadataFiles": [],
    "template": [
      "default",
      "templates/modern",
      "tctemplate"
    ],
    "postProcessors": [],
    "noLangKeyword": false,
    "sitemap": {
      "baseUrl": "https://docs.timecockpit.com",
      "priority": 0.1,
      "changefreq": "monthly",
      "fileOptions": {
        "doc/**.md": {
          "priority": 0.7,
          "changefreq": "monthly"
        },
        "doc/getting-started/**.md": {
          "priority": 0.9,
          "changefreq": "monthly"
        },
        "doc/for-users.md": {
          "priority": 0.9,
          "changefreq": "monthly"
        },
        "doc/for-developers.md": {
          "priority": 0.9,
          "changefreq": "monthly"
        },
        "doc/*-faq.md": {
          "priority": 0.9,
          "changefreq": "monthly"
        },
        "doc/release-notes/**.md": {
          "priority": 0.3,
          "changefreq": "yearly"
        },
        "api/**.yml": {
          "priority": 0.2,
          "changefreq": "yearly"
        }
      }
    }
  },
