{{!time cockpit: copy of the docfx 2.81.0 "modern" layout/_master.tmpl plus canonical/hreflang and social meta tags, analytics, the all-pages link and the consent block. On every docfx upgrade run `dotnet docfx template export modern` and re-diff against `_exported_templates/modern/layout/_master.tmpl`.}}
{{!include(/^public/.*/)}}
{{!include(favicon.ico)}}
{{!include(logo.svg)}}
<!DOCTYPE html>
<html {{#_lang}}lang="{{_lang}}"{{/_lang}}>
  <head>
    <meta charset="utf-8">
    {{#redirect_url}}
      <meta http-equiv="refresh" content="0;URL='{{redirect_url}}'">
    {{/redirect_url}}
    {{^redirect_url}}
      {{!time cockpit: API pages (ManagedReference models, recognizable by name.0.value)
          add the namespace to the title, drop the site suffix to stay under 70 characters, and get a generated description.}}
      <title>{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}}{{#namespace.uid}} ({{namespace.uid}}){{/namespace.uid}}{{^name.0.value}} {{#_appTitle}}| {{_appTitle}}{{/_appTitle}}{{/name.0.value}}</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <meta name="title" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}}{{#namespace.uid}} ({{namespace.uid}}){{/namespace.uid}}{{^name.0.value}} {{#_appTitle}}| {{_appTitle}}{{/_appTitle}}{{/name.0.value}}">
      {{#description}}<meta name="description" content="{{description}}">{{/description}}
      {{^description}}{{#name.0.value}}<meta name="description" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}}{{#namespace.uid}} in the {{namespace.uid}} namespace{{/namespace.uid}}{{#assemblies.0}}, assembly {{assemblies.0}}.dll{{/assemblies.0}}. time cockpit .NET API reference for customizing and scripting the data model.">{{/name.0.value}}{{/description}}
      {{#_noindex}}<meta name="robots" content="noindex, follow">{{/_noindex}}
      {{!time cockpit: _siteBase, _lang, _xDefault, _ogLocale come from globalMetadata (docfx.json = EN, de/docfx.json = DE).
          The hreflang link to the other language and og:locale:alternate are added after the build by
          tools/FixHreflang/fix-hreflang.ps1 for pages that have a translation (front matter en_page on DE pages).}}
      <link rel="canonical" href="{{_siteBase}}{{{_path}}}">
      <link rel="alternate" hreflang="{{_lang}}" href="{{_siteBase}}{{{_path}}}">
      {{#_xDefault}}<link rel="alternate" hreflang="x-default" href="{{_siteBase}}{{{_path}}}">{{/_xDefault}}
      {{#en_page}}<meta name="docfx:en-page" content="{{en_page}}">{{/en_page}}
      {{!time cockpit: social previews. JSON-LD (WebSite, TechArticle, BreadcrumbList, FAQPage) is built in public/main.js.}}
      <meta property="og:type" content="article">
      <meta property="og:site_name" content="time cockpit documentation">
      <meta property="og:locale" content="{{_ogLocale}}{{^_ogLocale}}en_US{{/_ogLocale}}">
      <meta property="og:url" content="{{_siteBase}}{{{_path}}}">
      <meta property="og:title" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}}">
      {{#description}}<meta property="og:description" content="{{description}}">{{/description}}
      <meta property="og:image" content="https://docs.timecockpit.com/images/{{#og_image}}{{og_image}}{{/og_image}}{{^og_image}}og-default.png{{/og_image}}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}}">
      {{#description}}<meta name="twitter:description" content="{{description}}">{{/description}}
      <meta name="twitter:image" content="https://docs.timecockpit.com/images/{{#og_image}}{{og_image}}{{/og_image}}{{^og_image}}og-default.png{{/og_image}}">
      {{#faq}}<meta name="docfx:faq" content="true">{{/faq}}
      <link rel="icon" href="{{_rel}}{{{_appFaviconPath}}}{{^_appFaviconPath}}favicon.ico{{/_appFaviconPath}}">
      <link rel="stylesheet" href="{{_rel}}public/docfx.min.css">
      <link rel="stylesheet" href="{{_rel}}public/main.css">
      <meta name="docfx:navrel" content="{{_navRel}}">
      <meta name="docfx:tocrel" content="{{_tocRel}}">
      {{#_noindex}}<meta name="searchOption" content="noindex">{{/_noindex}}
      {{#_enableSearch}}<meta name="docfx:rel" content="{{_rel}}">{{/_enableSearch}}
      {{#_disableNewTab}}<meta name="docfx:disablenewtab" content="true">{{/_disableNewTab}}
      {{#_disableTocFilter}}<meta name="docfx:disabletocfilter" content="true">{{/_disableTocFilter}}
      {{#docurl}}<meta name="docfx:docurl" content="{{docurl}}">{{/docurl}}
      <meta name="loc:inThisArticle" content="{{__global.inThisArticle}}">
      <meta name="loc:searchResultsCount" content="{{__global.searchResultsCount}}">
      <meta name="loc:searchNoResults" content="{{__global.searchNoResults}}">
      <meta name="loc:tocFilter" content="{{__global.tocFilter}}">
      <meta name="loc:nextArticle" content="{{__global.nextArticle}}">
      <meta name="loc:prevArticle" content="{{__global.prevArticle}}">
      <meta name="loc:themeLight" content="{{__global.themeLight}}">
      <meta name="loc:themeDark" content="{{__global.themeDark}}">
      <meta name="loc:themeAuto" content="{{__global.themeAuto}}">
      <meta name="loc:changeTheme" content="{{__global.changeTheme}}">
      <meta name="loc:copy" content="{{__global.copy}}">
      <meta name="loc:downloadPdf" content="{{__global.downloadPdf}}">

      <script type="module" src="./{{_rel}}public/docfx.min.js"></script>

      <script>
        const theme = localStorage.getItem('theme') || 'auto'
        document.documentElement.setAttribute('data-bs-theme', theme === 'auto' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : theme)
      </script>

      {{!time cockpit: analytics. Google Analytics is NOT loaded here, see the consent block at the
          end of <body>. Simple Analytics is cookieless and stores no personal data, so it needs no
          consent, but like GA it must stay silent on local previews and the docs-dev staging site.}}
      <script>
        window.isProductionHost = function () {
          var h = location.hostname;
          return h !== 'localhost' && h !== '127.0.0.1' && h.indexOf('docs-dev') === -1;
        };
        if (window.isProductionHost()) {
          var sa = document.createElement('script');
          sa.async = true;
          sa.src = 'https://scripts.simpleanalyticscdn.com/latest.js';
          document.head.appendChild(sa);
        }
      </script>
    {{/redirect_url}}
  </head>

  {{^redirect_url}}
  <body class="tex2jax_ignore" data-layout="{{_layout}}{{layout}}" data-yaml-mime="{{yamlmime}}">
    <header class="bg-body border-bottom">
      {{^_disableNavbar}}
      <nav id="autocollapse" class="navbar navbar-expand-md" role="navigation">
        <div class="container-xxl flex-nowrap">
          <a class="navbar-brand" href="{{_appLogoUrl}}{{^_appLogoUrl}}{{_rel}}index.html{{/_appLogoUrl}}">
            <img id="logo" class="svg" src="{{_rel}}{{{_appLogoPath}}}{{^_appLogoPath}}logo.svg{{/_appLogoPath}}" alt="{{_appName}}" >
            {{_appName}}
          </a>
          <button class="btn btn-lg d-md-none border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navpanel" aria-controls="navpanel" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-three-dots"></i>
          </button>
          <div class="collapse navbar-collapse" id="navpanel">
            <div id="navbar">
              {{#_enableSearch}}
              <form class="search" role="search" id="search">
                <i class="bi bi-search"></i>
                <input class="form-control" id="search-query" type="search" disabled placeholder="{{__global.search}}" autocomplete="off" aria-label="Search">
              </form>
              {{/_enableSearch}}
            </div>
          </div>
          {{!time cockpit: language switch (EN | DE). The link to the other language defaults to that
              language's start page; tools/FixHreflang/fix-hreflang.ps1 points it at the translated
              counterpart after the build when one exists. _isEn/_isDe/_altRoot come from globalMetadata.}}
          <div class="tc-lang" role="navigation" aria-label="Language">
            {{#_isEn}}<span class="tc-lang-link active" lang="en" aria-current="true">EN</span>{{/_isEn}}{{^_isEn}}<a class="tc-lang-link" data-lang="en" lang="en" hreflang="en" href="{{_altRoot}}">EN</a>{{/_isEn}}
            {{#_isDe}}<span class="tc-lang-link active" lang="de" aria-current="true">DE</span>{{/_isDe}}{{^_isDe}}<a class="tc-lang-link" data-lang="de" lang="de" hreflang="de" href="{{_altRoot}}">DE</a>{{/_isDe}}
          </div>
        </div>
      </nav>
      {{/_disableNavbar}}
    </header>

    <main class="container-xxl">
      {{^_disableToc}}
      <div class="toc-offcanvas">
        <div class="offcanvas-md offcanvas-start" tabindex="-1" id="tocOffcanvas" aria-labelledby="tocOffcanvasLabel">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="tocOffcanvasLabel">Table of Contents</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#tocOffcanvas" aria-label="Close"></button>
          </div>
          <div class="offcanvas-body">
            <nav class="toc" id="toc"></nav>
          </div>
        </div>
      </div>
      {{/_disableToc}}

      <div class="content">
        <div class="actionbar">
          {{^_disableToc}}
          <button class="btn btn-lg border-0 d-md-none"
              type="button" data-bs-toggle="offcanvas" data-bs-target="#tocOffcanvas"
              aria-controls="tocOffcanvas" aria-expanded="false" aria-label="Show table of contents">
            <i class="bi bi-list"></i>
          </button>
          {{/_disableToc}}

          {{^_disableBreadcrumb}}
          <nav id="breadcrumb"></nav>
          {{/_disableBreadcrumb}}
        </div>

        <article data-uid="{{uid}}">
          {{!body}}
        </article>

        {{^_disableContribution}}
        <div class="contribution d-print-none">
          {{#sourceurl}}
          <a href="{{sourceurl}}" class="edit-link">{{__global.improveThisDoc}}</a>
          {{/sourceurl}}
          {{^sourceurl}}{{#docurl}}
          <a href="{{docurl}}" class="edit-link">{{__global.improveThisDoc}}</a>
          {{/docurl}}{{/sourceurl}}
        </div>
        {{/_disableContribution}}

        {{^_disableNextArticle}}
        <div class="next-article d-print-none border-top" id="nextArticle"></div>
        {{/_disableNextArticle}}

      </div>

      {{^_disableAffix}}
      <div class="affix">
        <nav id="affix"></nav>
      </div>
      {{/_disableAffix}}
    </main>

    {{#_enableSearch}}
    <div class="container-xxl search-results" id="search-results"></div>
    {{/_enableSearch}}

    <footer class="border-top text-secondary">
      <div class="container-xxl">
        <div class="flex-fill">
          {{{_appFooter}}}{{^_appFooter}}<span>Made with <a href="https://dotnet.github.io/docfx">docfx</a></span>{{/_appFooter}}
          {{!time cockpit: server-rendered link to the index of all pages, for crawlers without JavaScript.}}
          &middot; <a href="{{_rel}}doc/all-pages.html">{{_labelAllPages}}{{^_labelAllPages}}All pages{{/_labelAllPages}}</a>
        </div>
      </div>
    </footer>

    {{!time cockpit: Silktide Consent Manager (vendored copy from www.timecockpit.com) and everything
        gated behind consent. Runs at the end of <body> because the banner needs the body element.
        GA4 is only inserted after "Analytics" consent; videos (main.js) only after "External Media".}}
    <link rel="stylesheet" id="silktide-consent-manager-css" href="{{_rel}}public/silktide-consent-manager.css">
    <script src="{{_rel}}public/silktide-consent-manager.js"></script>
    <script>
      (function () {
        var GA_ID = 'G-2K2QFK27YB'; // docs.timecockpit.com property, not the website's

        // Consent Mode defaults; gtag.js itself is inserted by loadTracking() after consent.
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
        gtag('js', new Date());
        gtag('config', GA_ID, { send_page_view: false });

        window.cookieConsent = { analytics: false, externalmedia: false };
        window.renewCookieConsent = function () {
          var icon = document.getElementById('silktide-cookie-icon');
          if (icon) icon.click();
        };
        // Consent given and a production host (window.isProductionHost is defined in <head>):
        // local previews and the docs-dev staging site must never report to GA.
        window.hasAnalyticsConsent = function () {
          return !!window.cookieConsent.analytics && window.isProductionHost();
        };

        var trackingLoaded = false;
        function loadTracking() {
          if (trackingLoaded) return false;
          trackingLoaded = true;
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(g);
          return true;
        }

        window.addEventListener('cookieConsentChanged', function () {
          document.documentElement.classList.toggle('externalmedia-granted', !!window.cookieConsent.externalmedia);
          var allow = window.hasAnalyticsConsent() ? 'granted' : 'denied';
          gtag('consent', 'update', { ad_storage: allow, analytics_storage: allow, ad_user_data: allow, ad_personalization: allow });
          if (allow === 'granted' && loadTracking()) {
            gtag('event', 'page_view', { page_title: document.title, page_location: location.href });
          }
        });

        // Silktide fires one callback per cookie type; coalesce into one event per user action.
        var dispatchPending = false;
        function dispatchConsentChanged() {
          if (dispatchPending) return;
          dispatchPending = true;
          setTimeout(function () {
            dispatchPending = false;
            window.dispatchEvent(new CustomEvent('cookieConsentChanged'));
          }, 0);
        }
        function setConsent(type, granted) {
          window.cookieConsent[type] = granted;
          dispatchConsentChanged();
        }

        // Banner texts in the page language (<html lang>); the DE site is a separate docfx build.
        var isDe = (document.documentElement.lang || 'en').toLowerCase().indexOf('de') === 0;
        var L = isDe ? {
          necessary: 'Notwendig',
          necessaryDesc: '<p>Diese Cookies sind für den Betrieb der Website notwendig und können nicht deaktiviert werden. Sie speichern Ihre Cookie-Einstellungen und Ihre Wahl des hellen oder dunklen Designs.</p>',
          analytics: 'Analyse',
          analyticsDesc: '<p>Wir verwenden Google Analytics, um anonymisierte Informationen darüber zu sammeln, wie Besucher diese Dokumentation nutzen. Dabei werden Daten an Google übermittelt. Das hilft uns, die Inhalte zu verbessern. (Unser cookiefreier Seitenzähler von Simple Analytics speichert keine personenbezogenen Daten und ist immer aktiv.)</p>',
          media: 'Externe Medien (YouTube, Vimeo)',
          mediaDesc: '<p>Eingebettete Videos sind standardmäßig blockiert. Wenn Sie zustimmen, können Videos ohne weitere manuelle Bestätigung abgespielt werden. YouTube und Vimeo können Cookies für Tracking und Personalisierung setzen, sobald Sie mit einem Video interagieren.</p>',
          banner: '<p>Wir verwenden Cookies auf dieser Website, um unseren Traffic zu analysieren und eingebettete Videos anzuzeigen. <a href="https://www.timecockpit.com/de/impressum/datenschutzbestimmungen/" target="_blank" rel="noopener">Datenschutzerklärung.</a></p>',
          acceptAll: 'Alle akzeptieren', acceptAllLabel: 'Alle Cookies akzeptieren',
          reject: 'Nicht notwendige ablehnen', rejectLabel: 'Nicht notwendige ablehnen',
          prefs: 'Einstellungen', prefsLabel: 'Einstellungen umschalten',
          prefsTitle: 'Ihre Cookie-Einstellungen anpassen',
          prefsDesc: '<p>Wir respektieren Ihr Recht auf Privatsphäre. Sie können auswählen, ob Sie bestimmte Arten von Cookies zulassen möchten. Ihre Cookie-Einstellungen gelten für diese gesamte Dokumentation.</p>'
        } : {
          necessary: 'Necessary',
          necessaryDesc: '<p>These cookies are necessary for the site to function and cannot be switched off. They store your cookie preferences and your light/dark theme choice.</p>',
          analytics: 'Analytics',
          analyticsDesc: '<p>We use Google Analytics to collect anonymized information about how visitors use this documentation. Data is shared with Google. This helps us improve the content. (Our cookieless page counter by Simple Analytics does not store personal data and is always active.)</p>',
          media: 'External Media (YouTube, Vimeo)',
          mediaDesc: '<p>Embedded videos are blocked by default. When you accept, videos can be played without further manual consent. YouTube and Vimeo may set cookies for tracking and personalization once you interact with a video.</p>',
          banner: '<p>We use cookies on this site to analyze our traffic and to show embedded videos. <a href="https://www.timecockpit.com/legal-notice/privacy-policy/" target="_blank" rel="noopener">Privacy Statement.</a></p>',
          acceptAll: 'Accept all', acceptAllLabel: 'Accept all cookies',
          reject: 'Reject non-essential', rejectLabel: 'Reject non-essential',
          prefs: 'Preferences', prefsLabel: 'Toggle preferences',
          prefsTitle: 'Customize your cookie preferences',
          prefsDesc: '<p>We respect your right to privacy. You can choose not to allow some types of cookies. Your cookie preferences apply across this documentation site.</p>'
        };

        silktideCookieBannerManager.updateCookieBannerConfig({
          background: { showBackground: false },
          cookieIcon: { position: 'bottomLeft' },
          cookieTypes: [
            {
              id: 'necessary',
              name: L.necessary,
              description: L.necessaryDesc,
              required: true
            },
            {
              id: 'analytics',
              name: L.analytics,
              description: L.analyticsDesc,
              defaultValue: false,
              onAccept: function () { setConsent('analytics', true); },
              onReject: function () { setConsent('analytics', false); }
            },
            {
              id: 'externalmedia',
              name: L.media,
              description: L.mediaDesc,
              defaultValue: false,
              onAccept: function () { setConsent('externalmedia', true); },
              onReject: function () { setConsent('externalmedia', false); }
            }
          ],
          text: {
            banner: {
              description: L.banner,
              acceptAllButtonText: L.acceptAll,
              acceptAllButtonAccessibleLabel: L.acceptAllLabel,
              rejectNonEssentialButtonText: L.reject,
              rejectNonEssentialButtonAccessibleLabel: L.rejectLabel,
              preferencesButtonText: L.prefs,
              preferencesButtonAccessibleLabel: L.prefsLabel
            },
            preferences: {
              title: L.prefsTitle,
              description: L.prefsDesc,
              creditLinkText: ' ',
              creditLinkAccessibleLabel: ' '
            }
          }
        });
      })();
    </script>
  </body>
  {{/redirect_url}}
</html>
